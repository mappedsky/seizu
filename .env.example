ESLINT_NO_DEV_ERRORS=true

# Auth toggle — use `make auth_enable` / `make auth_disable` to switch.
DEVELOPMENT_ONLY_REQUIRE_AUTH=false

# Optional service tokens — leave empty to disable the feature in development.
SLACK_OAUTH_BOT_TOKEN=

# External MCP proxies used by the chat agent. This is a JSON array; see
# docs/root/install/external-mcp.md for schemas and complete examples.
# Toggle with `make external_mcp_enable` / `make external_mcp_disable`, then use
# `make external_mcp_login` to authorize the local proxy through Authentik.
MCP_EXTERNAL_ENABLED=false
# Agent Plugin MCP binding. Seizu only connects to its own proxies, so the URL a
# package declares is documentation, not an address: none (default) ignores it
# and matches on proxy name, lax prefers a proxy declaring the URL, and strict
# requires one.
MCP_EXTERNAL_PLUGIN_URL_MATCH_MODE=none
# The local dev profile points straight at the network-internal adapter that
# supplies the GitHub PAT: one service identity, read-only, nothing to expire.
# The obot OAuth proxy lives in the external-mcp-oauth profile for when the
# challenge/refresh path is what you want to exercise.
# The upstream aliases match the logical endpoints in the bundled development
# Agent Plugin under .config/dev/seizu/plugins/portable-security-review.
# MCP_EXTERNAL_PROXIES=[]
# MCP_EXTERNAL_PROXIES=[{"name":"github","url":"http://external-mcp-github-auth:8080/mcp","upstream_urls":["https://mcp.github.test/mcp"],"transport":"streamable_http","auth_mode":"header_delegation"},{"name":"deps","url":"http://external-mcp-deps:8080/mcp","upstream_urls":["https://mcp.deps.test/mcp"],"transport":"streamable_http","auth_mode":"header_delegation","require_confirmation":false}]
# Retries for a call an external MCP upstream refused as rate-limited. The
# refusal names its own delay and Seizu waits exactly that long; these bound how
# much waiting one call may do. 0 hands the refusal straight to the agent.
# deps.dev package metadata, run under the external-mcp profile
# (ghcr.io/mappedsky/depsdevmcp). It answers what a package version *declares* it
# requires and what its resolved graph pulls in -- neither of which the security
# graph records, and neither of which the sandbox can fetch, since it has no
# egress. Read-only and unauthenticated; only a package name and version leave
# the network. Its default listen address is loopback, so the container needs
# DEPSDEVMCP_HTTP_ADDRESS set for anything else to reach it.
# DEPSDEVMCP_CACHE_CAPACITY=256
# How long a proxy's discovered tool listing may be reused across turns, per
# user. Duplicate discovery within one turn is always removed; this is the
# cross-turn layer, which can be stale, so it defaults to 0 (off).
# MCP_EXTERNAL_DISCOVERY_TTL_SECONDS=0
# MCP_EXTERNAL_RATE_LIMIT_RETRIES=2
# MCP_EXTERNAL_RATE_LIMIT_MAX_WAIT_SECONDS=60
# MCP_EXTERNAL_RATE_LIMIT_DEFAULT_WAIT_SECONDS=5
# MCP_EXTERNAL_CONFIRMATION_REQUIRED_TOOLS=ext__drive__delete_file,ext__drive__share_file
# MCP_EXTERNAL_PROXY_TOKEN=

# Optional lightweight Obot OAuth proxy and official GitHub MCP server for local
# integration testing. `make external_mcp_enable` also enables local Authentik;
# its blueprint creates this dedicated confidential OAuth client automatically.
# DEV_MCP_PROXY_OAUTH_CLIENT_ID=seizu-external-mcp-proxy
# DEV_MCP_PROXY_OAUTH_CLIENT_SECRET=seizu-external-mcp-proxy-dev-secret
# DEV_MCP_PROXY_OAUTH_AUTHORIZE_URL=http://localhost:9000/application/o/seizu-external-mcp-proxy
# DEV_MCP_PROXY_SCOPES=openid,email,profile
# DEV_MCP_PROXY_UPSTREAM_URL=http://external-mcp-github-auth:8080
# DEV_MCP_PROXY_ENCRYPTION_KEY=
# DEV_GITHUB_MCP_TOKEN=
# DEV_GITHUB_MCP_READ_ONLY=1
# DEV_GITHUB_MCP_TOOLSETS=default

# Optional Cartography credentials — only needed by the manual Cartography
# profile or scheduled sync worker for the corresponding enabled modules.
# CARTOGRAPHY_GITHUB_CONFIG is a base64-encoded JSON config, not a bare PAT —
# see docs/root/install/quickstart.md ("Loading GitHub data") for how to build it.
CARTOGRAPHY_GITHUB_CONFIG=
# Deprecated compatibility alias for CARTOGRAPHY_GITHUB_CONFIG. Despite its
# old name, this must also contain the complete base64-encoded configuration.
CARTOGRAPHY_GITHUB_TOKEN=
CARTOGRAPHY_AIRBYTE_CLIENT_SECRET=
CARTOGRAPHY_ANTHROPIC_API_KEY=
CARTOGRAPHY_AZURE_CLIENT_SECRET=
CARTOGRAPHY_MICROSOFT_CLIENT_SECRET=
CARTOGRAPHY_CLOUDFLARE_TOKEN=
CARTOGRAPHY_NIST_NVD_TOKEN=
CARTOGRAPHY_CROWDSTRIKE_CLIENT_ID=
CARTOGRAPHY_CROWDSTRIKE_CLIENT_SECRET=
CARTOGRAPHY_DATABRICKS_TOKEN=
CARTOGRAPHY_DATABRICKS_CLIENT_SECRET=
CARTOGRAPHY_DATABRICKS_ACCOUNT_CLIENT_SECRET=
CARTOGRAPHY_DIGITALOCEAN_TOKEN=
CARTOGRAPHY_GITLAB_TOKEN=
CARTOGRAPHY_GOOGLEWORKSPACE_GOOGLE_APPLICATION_CREDENTIALS=
CARTOGRAPHY_GSUITE_GOOGLE_APPLICATION_CREDENTIALS=
CARTOGRAPHY_JAMF_PASSWORD=
CARTOGRAPHY_JUMPCLOUD_API_KEY=
CARTOGRAPHY_KANDJI_TOKEN=
CARTOGRAPHY_KEYCLOAK_CLIENT_SECRET=
CARTOGRAPHY_LASTPASS_CID=
CARTOGRAPHY_LASTPASS_PROVHASH=
CARTOGRAPHY_BIGFIX_PASSWORD=
CARTOGRAPHY_DUO_API_KEY=
CARTOGRAPHY_DUO_API_SECRET=
CARTOGRAPHY_WORKDAY_API_PASSWORD=
CARTOGRAPHY_OPENAI_API_KEY=
CARTOGRAPHY_PAGERDUTY_API_KEY=
CARTOGRAPHY_OKTA_API_KEY=
CARTOGRAPHY_SALESFORCE_CLIENT_SECRET=
CARTOGRAPHY_SALESFORCE_PRIVATE_KEY=
CARTOGRAPHY_SCALEWAY_SECRET_KEY=
CARTOGRAPHY_SEMGREP_APP_TOKEN=
CARTOGRAPHY_SENTRY_TOKEN=
CARTOGRAPHY_SENTINELONE_API_TOKEN=
CARTOGRAPHY_SLACK_TOKEN=
CARTOGRAPHY_SNIPEIT_TOKEN=
CARTOGRAPHY_SOCKETDEV_TOKEN=
CARTOGRAPHY_SPACELIFT_API_TOKEN=
CARTOGRAPHY_SPACELIFT_API_KEY_ID=
CARTOGRAPHY_SPACELIFT_API_KEY_SECRET=
CARTOGRAPHY_SUBIMAGE_CLIENT_ID=
CARTOGRAPHY_SUBIMAGE_CLIENT_SECRET=
CARTOGRAPHY_TAILSCALE_TOKEN=
CARTOGRAPHY_TAILSCALE_OAUTH_CLIENT_ID=
CARTOGRAPHY_TAILSCALE_OAUTH_CLIENT_SECRET=
CARTOGRAPHY_TENABLE_ACCESS_KEY=
CARTOGRAPHY_TENABLE_SECRET_KEY=
CARTOGRAPHY_VERCEL_TOKEN=
CARTOGRAPHY_CIRCLECI_TOKEN=
CARTOGRAPHY_WORKOS_API_KEY=

# Optional prefixed SDK configuration. The sync activity translates these to
# the conventional names required by the upstream SDK only in the subprocess.
# CARTOGRAPHY_AWS_PROFILE=
# CARTOGRAPHY_AWS_REGION=
# CARTOGRAPHY_AWS_DEFAULT_REGION=
# CARTOGRAPHY_AWS_CONFIG_FILE=
# CARTOGRAPHY_AWS_SHARED_CREDENTIALS_FILE=
# CARTOGRAPHY_AWS_ACCESS_KEY_ID=
# CARTOGRAPHY_AWS_SECRET_ACCESS_KEY=
# CARTOGRAPHY_AWS_SESSION_TOKEN=
# CARTOGRAPHY_AWS_CONTAINER_CREDENTIALS_RELATIVE_URI=
# CARTOGRAPHY_AWS_CONTAINER_CREDENTIALS_FULL_URI=
# CARTOGRAPHY_AWS_EC2_METADATA_SERVICE_ENDPOINT=
# CARTOGRAPHY_AWS_ROLE_ARN=
# CARTOGRAPHY_AWS_WEB_IDENTITY_TOKEN_FILE=
# CARTOGRAPHY_GOOGLE_APPLICATION_CREDENTIALS=/etc/cartography/gcp-credentials.json
# CARTOGRAPHY_GOOGLE_CLOUD_PROJECT=
# CARTOGRAPHY_CLOUDSDK_CONFIG=
# CARTOGRAPHY_OCI_CONFIG_FILE=/var/cartography/.oci/config
# CARTOGRAPHY_OCI_CONFIG_PROFILE=
# CARTOGRAPHY_OCI_CLI_AUTH=
# CARTOGRAPHY_OCI_CLI_REGION=
# CARTOGRAPHY_STATSD_ENABLED=true
# CARTOGRAPHY_STATSD_HOST=telegraf

# APOC plugin toggle — use `make apoc_enable` / `make apoc_disable` to switch.
# When enabled, Neo4j downloads the matching APOC version on first start (requires internet).
NEO4J_PLUGINS=

# Neo4j live-version testing — use `make neo4j_current` / `make neo4j_latest`.
# `neo4j_latest` enables docker-compose.neo4j-latest.yml, which uses a separate
# neo4j_latest_data volume so the 5.26 development database is not upgraded.
COMPOSE_FILE=docker-compose.yml
NEO4J_LATEST_IMAGE_TAG=2026.04.0

# Neo4j notification severity (WARNING, INFORMATION, OFF).
# Set to OFF to suppress schema warnings when the database is not fully populated.
# NEO4J_NOTIFICATIONS_MIN_SEVERITY=WARNING

# Extra procedures the Cypher query validator permits, beyond the built-in
# read-only schema procedures allowed by default. Comma-separated; each entry
# is an exact procedure name (apoc.meta.stats) or a namespace prefix ending in
# a dot (apoc., gds.). This does not permit dangerous function namespaces such
# as apoc.cypher.* or gds.*. Empty by default.
# QUERY_VALIDATOR_ALLOWED_PROCEDURES=

# Timeout settings (all values in seconds). Defaults shown.
# NEO4J_CONNECTION_TIMEOUT=10    # TCP connection to Neo4j
# NEO4J_QUERY_TIMEOUT=30         # server-side Neo4j transaction timeout
# MCP_GRAPH_QUERY_REJECT_UNINDEXED=true  # reject risky graph__query plans and return EXPLAIN
# MCP_GRAPH_QUERY_UNINDEXED_MAX_ESTIMATED_ROWS=100000  # max plan cardinality when a non-index scan is present; 0 rejects every such scan
# API_REQUEST_TIMEOUT=60         # FastAPI request timeout and Gunicorn worker watchdog
# JWKS_FETCH_TIMEOUT=10          # JWKS endpoint HTTP request
# AWS_CONNECT_TIMEOUT=5          # boto3 TCP connection (for example SQS)
# AWS_READ_TIMEOUT=30            # boto3 read operation (for example SQS)
# SQL_STATEMENT_TIMEOUT=30       # asyncpg/PostgreSQL statement timeout
# SLACK_TIMEOUT=30               # Slack SDK API call timeout

# Seconds to cache the introspected graph schema process-wide (0 disables).
# Agents re-introspect constantly, so this turns a per-call cost into a per-TTL
# one for the schema route, graph__schema, MCP and the sandbox subagent.
# GRAPH_SCHEMA_CACHE_TTL_SECONDS=300

# PostgreSQL application database URL and credentials.
# Keep credentials out of SQL_DATABASE_URL so only SQL_DATABASE_PASSWORD needs
# secret-manager handling. Credential-bearing URLs remain supported.
# In development the docker-compose.yml pre-configures the postgres container URL.
# SQL_DATABASE_URL=postgresql://postgres:5432/seizu
# SQL_DATABASE_USER=seizu
# SQL_DATABASE_PASSWORD=
# SNOWFLAKE_MACHINE_ID=1

# Temporal-backed configurable workflows and code-defined workflow activities.
# Address of the Temporal frontend (gRPC). docker-compose sets temporal:7233.
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# Task queue shared by schedules, configurable workflows, and the worker.
# TEMPORAL_TASK_QUEUE=seizu-workflows
# Set false to disable the worker process without removing the service.
# TEMPORAL_WORKER_ENABLED=true
# Activity slots per worker process. This is the cluster-wide bound on
# distributed chat plan steps: per-turn limits stop one conversation fanning out
# too wide, slots stop many conversations doing it at once.
# TEMPORAL_MAX_CONCURRENT_ACTIVITIES=100
# Configurable workflow query/activity limits and reconciliation intervals.
# WORKFLOW_QUERY_MAX_ROWS=200
# Maximum serialized bytes retained for an activity output or forwarded input.
# WORKFLOW_RESULT_MAX_BYTES=1000000
# WORKFLOW_WATCH_POLL_SECONDS=20
# WORKFLOW_RECONCILE_SECONDS=30
# Comma-separated activity modules. SCHEDULED_QUERY_MODULES remains a
# compatibility alias for one release.
# WORKFLOW_ACTIVITY_MODULES=reporting.scheduled_query_modules.sqs,reporting.scheduled_query_modules.slack,reporting.scheduled_query_modules.statsd
# Cap on query result rows forwarded into a code-defined workflow.
# TEMPORAL_WORKFLOW_MAX_RESULT_ROWS=200
# Allowlist of code-defined workflows exposed as top-level activity types
# (comma-separated). Empty → all registered workflows,
# e.g. enable assessment but not remediation: TEMPORAL_ENABLED_WORKFLOWS=cve_repo_report
# TEMPORAL_ENABLED_WORKFLOWS=
# Per-repository AI chat activity timeout in seconds.
# TEMPORAL_CHAT_ACTIVITY_TIMEOUT_SECONDS=600

# Cartography syncs (cartography_sync workflow): runs cartography intel-module
# syncs as a staged pipeline on the dedicated seizu-cartography-worker service
# (Dockerfile.cartography). Module credentials come from the cartography token
# vars above. The sync worker itself reads TEMPORAL_ADDRESS/TEMPORAL_NAMESPACE
# plus CARTOGRAPHY_NEO4J_URI (set in docker-compose.yml; and optionally
# CARTOGRAPHY_NEO4J_USER + CARTOGRAPHY_NEO4J_PASSWORD when Neo4j auth is on).
# CARTOGRAPHY_NEO4J_USER=
# CARTOGRAPHY_NEO4J_PASSWORD=
# Task queue the sync worker polls (workflow activities are dispatched there).
# CARTOGRAPHY_TASK_QUEUE=seizu-cartography
# Allowlist of registry modules scheduled syncs may run (comma-separated;
# empty → all modules supported by the pinned Cartography release). Enforced
# at save time, at dispatch, and again by the credential-bearing sync worker.
# CARTOGRAPHY_ENABLED_MODULES=
# Default per-module-run timeout in seconds (overridable per schedule).
# CARTOGRAPHY_MODULE_TIMEOUT_SECONDS=3600
# How long a module run may wait (seconds) for an overlapping run of the same
# module to finish (serialized via Temporal workflow-ID uniqueness; concurrent
# same-module syncs race on cartography's update tags and can delete each
# other's data).
# CARTOGRAPHY_MODULE_WAIT_SECONDS=3600
# Temporal retry attempts per module run (config errors never retry).
# CARTOGRAPHY_SYNC_RETRY_ATTEMPTS=2

# CVE dependency remediation (cve_dependency_remediation workflow): a
# coding-agent CLI in an ephemeral sandbox upgrades the vulnerable dependency
# (with compatibility code changes), runs the tests, and opens a PR.
# Credentials are phase-isolated: the coding agent never runs with the GitHub
# token in its environment. No enable flag and no per-user permission —
# configured = enabled; reachable only via admin-managed scheduled queries,
# so disable the query (or remove this config) to turn it off.
# Coding-agent CLI + credentials (shared SANDBOX_AGENT_* family; the remediation
# workflow is one consumer):
# SANDBOX_AGENT_PROVIDER=claude   # "claude" (Claude Code), "codex", or "opencode"
# E2B template for the run. Empty → the provider's official prebuilt template
# ("claude"/"codex"/"opencode" — CLI preinstalled, no per-run npm install);
# "none" → base image (installs the CLI itself). Ignored on self-hosted backends.
# SANDBOX_AGENT_TEMPLATE=
# For opencode, SANDBOX_AGENT_MODEL is required as "provider/model" and
# selects the provider, e.g. deepseek/deepseek-v4-pro (uses DEEPSEEK_API_KEY,
# the same key the chat assistant uses).
# SANDBOX_AGENT_MODEL=
# SANDBOX_AGENT_API_KEY=          # Empty → falls back to the model provider's global *_API_KEY
# Command whose stdout becomes a per-run agent API key — use to mint
# short-lived credentials from a broker instead of a long-lived key.
# SANDBOX_AGENT_API_KEY_COMMAND=
# LLM gateway/proxy base URL exported to the agent (ANTHROPIC_BASE_URL /
# OPENAI_BASE_URL); pair with the key command for short-lived gateway keys.
# SANDBOX_AGENT_BASE_URL=
# Ephemeral credential-proxy sandbox: run a short-lived LiteLLM proxy in its own
# sandbox holding the real provider key, and hand the agent sandbox only a
# budget-capped virtual key. The real key never enters the untrusted agent VM;
# the virtual key dies when the proxy sandbox is torn down. All providers
# (opencode needs SANDBOX_AGENT_MODEL); mutually exclusive with SANDBOX_AGENT_BASE_URL.
# SANDBOX_AGENT_CREDENTIAL_PROXY_ENABLED=false
# SANDBOX_AGENT_CREDENTIAL_PROXY_MAX_BUDGET=5   # USD cap on the per-run virtual key
# Hash-locked requirement file a templateless proxy sandbox installs. Empty →
# the checked-in reporting/services/sandbox_proxy_requirements.txt (regenerate
# with `make lock_proxy_requirements`). Point this at your own compiled lock to
# run a different LiteLLM, or one resolved for another sandbox runtime — the
# install refuses to proceed on a sandbox the lock was not resolved for.
# SANDBOX_AGENT_CREDENTIAL_PROXY_REQUIREMENTS_FILE=
# E2B template for the proxy sandbox — ours (`make build_proxy_template`) or any
# image providing a working litellm proxy. Set → runs use it as built, installing
# and checking nothing (rebuild it yourself when the lock changes). Empty → plain
# base image plus a run-time install from the lock above.
# SANDBOX_AGENT_CREDENTIAL_PROXY_TEMPLATE=
# REMEDIATION_TIMEOUT_SECONDS=1800
# Post-push CI watch: the workflow polls the PR's checks; relevant failures get
# a coding-agent fix run pushed to the same branch, irrelevant ones an
# explanatory PR comment. Checks stuck in queued are ignored.
# REMEDIATION_CI_MAX_WAIT_SECONDS=3600   # total wait for checks to settle; 0 disables the watch
# REMEDIATION_CI_POLL_SECONDS=120
# REMEDIATION_CI_QUEUED_STUCK_SECONDS=1800  # queued this long without starting → ignored
# REMEDIATION_CI_FIX_MAX_ATTEMPTS=1      # coding-agent fix runs per PR; 0 → watch/record only
# Pinned gh (GitHub CLI) version installed in the sandbox when not already present.
# REMEDIATION_GH_VERSION=2.62.0
# Expected SHA-256 of the pinned gh linux_amd64 tarball for an independent
# supply-chain pin (empty → verify against the release's own checksums).
# REMEDIATION_GH_SHA256=
# REMEDIATION_GITHUB_HOST=github.com  # or a GitHub Enterprise Server hostname
# GitHub token for clone/push/PR and the worker-side CI watch; the coding
# agent never sees it. Direct mode: fine-grained PAT on the target repos
# (contents + pull requests write, issues write, checks + commit statuses
# read). Fork mode: classic PAT on a machine account. See the docs section
# "GitHub token setup" (docs/root/install/temporal-workflows.md).
# REMEDIATION_GITHUB_TOKEN=
# Fork mode: push the work branch to a bot-owned fork (created on demand) and
# open cross-repo PRs. NOTE: fine-grained PATs are single-resource-owner and
# can't span the bot's forks + another owner's targets (fork creation also
# needs Administration:write) — use a classic PAT on the bot account
# (public_repo, or repo for private targets) or a GitHub App token.
# REMEDIATION_USE_FORK=false
# REMEDIATION_FORK_ORG=       # org owning the forks; empty → the token user's account
# REMEDIATION_GIT_USER=seizu-remediation-bot
# REMEDIATION_GIT_EMAIL=seizu-remediation@localhost

# Scheduled chats (recurring headless agent runs managed from the chat UI;
# creating/editing them requires the chat:schedule permission).
# CHAT_SCHEDULES_ENABLED=true
# Timeout in seconds for one scheduled headless agent session.
# CHAT_SCHEDULE_TIMEOUT_SECONDS=600

# Master switch for the chat assistant feature (routes + UI). Default false.
# CHAT_ENABLED=false
#
# LLM provider for chat. Default "mock" keeps local dev keyless and deterministic.
# Any other value routes through LiteLLM, so the provider/model surface is whatever
# LiteLLM supports rather than a fixed list. Legacy values (openai, anthropic,
# gemini, deepseek) still work and namespace bare model ids. For a real provider,
# set this to "litellm" when using fully-qualified environment or profile models.
# CHAT_LLM_PROVIDER=mock
#
# CHAT_LLM_MODEL is the environment base model and fallback. It is required when
# CHAT_LLM_PROVIDER is not "mock" only if no enabled default model profile exists;
# otherwise the profile supplies every runtime stage. Prefer a provider-namespaced
# string; pick the current model rather than copying these examples blindly:
#   openai     e.g. openai/gpt-4o                  (https://platform.openai.com/docs/models)
#   anthropic  e.g. anthropic/claude-sonnet-4-6    (https://docs.anthropic.com/en/docs/about-claude/models)
#   gemini     e.g. gemini/gemini-2.5-flash        (https://ai.google.dev/gemini-api/docs/models)
#   deepseek   e.g. deepseek/deepseek-reasoner     (https://api-docs.deepseek.com/quick_start/pricing)
# See LiteLLM's provider list for the full set: https://docs.litellm.ai/docs/providers
# CHAT_LLM_MODEL=
# CHAT_LLM_API_KEY=
# Point at a self-hosted LiteLLM proxy or other OpenAI-compatible gateway (api_base):
# CHAT_LLM_BASE_URL=
# CHAT_LLM_TEMPERATURE=0.2
# Per-call output cap. 0 (default) derives it from the model's own
# max_output_tokens, capped by CHAT_LLM_MAX_OUTPUT_TOKENS_CAP. A constant is
# wrong in both directions: models report ceilings from 16,384 to 393,216, and
# a request above a model's ceiling is refused outright rather than reduced.
# CHAT_LLM_MAX_TOKENS=0
# CHAT_LLM_MAX_OUTPUT_TOKENS_CAP=32768
# How much of that allowance a reasoning model may spend thinking: default,
# none, minimal, low, medium, high, or xhigh; empty also uses the provider
# default. LiteLLM translates this fixed vocabulary into each provider's native
# shape. Reasoning and answer share one allowance on these providers.
# CHAT_LLM_REASONING_EFFORT=
# Per-stage overrides; empty inherits the global. Reasoning is what
# decomposition and judgment are for; a classifier and a report-writer only lose
# answer allowance to it.
# Defaults to none: measured 21/21 routes correct with output halved.
# CHAT_LLM_ROUTER_REASONING_EFFORT=none
# CHAT_LLM_PLANNER_REASONING_EFFORT=
# CHAT_LLM_WORKER_REASONING_EFFORT=
# The worker's summary passes; transcription, not decision-making.
# CHAT_LLM_WORKER_SUMMARY_REASONING_EFFORT=
# The sandbox sub-agent loop -- the highest-volume stage there is, so this
# dominates a delegating turn. Empty inherits CHAT_LLM_WORKER_REASONING_EFFORT.
# CHAT_LLM_SANDBOX_REASONING_EFFORT=
# CHAT_LLM_VERIFIER_REASONING_EFFORT=
# CHAT_LLM_SYNTHESIZER_REASONING_EFFORT=
# CHAT_LLM_TIMEOUT_SECONDS=60
# CHAT_LLM_MAX_RETRIES=2
# Auto-continue answers cut off by the output-token limit, stitched seamlessly.
# Set CHAT_LLM_MAX_CONTINUATIONS=0 to disable (keep the manual continue button).
# CHAT_LLM_MAX_CONTINUATIONS=2
# CHAT_LLM_MAX_RESPONSE_CHARS=60000
# CHAT_LLM_CONTEXT_MAX_MESSAGES=80
# Prior-conversation budget in TOKENS (counted with the provider's tokenizer),
# clamped by the share of the model's own input window history may occupy. The
# window comes from litellm's model database; override it, or raise the fallback,
# for a large-context model litellm cannot identify.
# CHAT_LLM_CONTEXT_MAX_TOKENS=40000
# CHAT_LLM_CONTEXT_WINDOW_SHARE=0.5
# CHAT_LLM_CONTEXT_WINDOW_TOKENS=0
# CHAT_LLM_CONTEXT_WINDOW_FALLBACK_TOKENS=32768
# Held back when sizing a call, for provider message framing and tokenizer
# differences we cannot observe. Under-counting is what fails a call.
# CHAT_LLM_CONTEXT_SAFETY_MARGIN=0.05
# Explicit prompt-cache breakpoints for providers that need them (Anthropic
# caches nothing without them). Automatic prefix caches are unaffected.
# CHAT_LLM_PROMPT_CACHE_ENABLED=true
# CHAT_LLM_PROMPT_CACHE_MIN_TOKENS=1024
# Disclose the tools skills declare in tools_required up front rather than on
# render (the tool list heads the cached prefix, so unlocking mid-turn
# invalidates it). Skipped when those schemas exceed the budget, so a large
# skill catalogue does not become "bind every tool on every call".
# CHAT_LLM_DISCLOSE_SKILL_TOOLS=true
# CHAT_LLM_DISCLOSE_SKILL_TOOLS_MAX_TOKENS=6000
# Log which part of a request (model, system prompt, tools, messages) changed
# since the previous call of the same kind -- the question a prompt-cache miss
# never answers on its own. A debugging aid: off by default, and it token-counts
# every component of every call.
# CHAT_LLM_CACHE_DIAGNOSTICS=false
# Condense the oldest turns of a long conversation instead of dropping them,
# cutting back in chunks so the condensed block stays byte-stable between
# compactions (40 turns measured at 5 compactions rather than one per turn).
# CHAT_LLM_HISTORY_COMPACTION=true
# CHAT_LLM_HISTORY_COMPACTION_TARGET=0.5
# CHAT_LLM_HISTORY_SUMMARY_MAX_TOKENS=1500
# CHAT_LLM_SYSTEM_PROMPT=
# CHAT_LLM_PROGRESSIVE_DISCLOSURE=true
# CHAT_LLM_MAX_AUTO_ACTIONS=12
# CHAT_LLM_MAX_PARALLEL_TOOL_CALLS=4
# Plan -> dispatch -> verify orchestration for complex chat requests (on by
# default; set false to use the single-agent path for interactive turns).
# CHAT_ORCHESTRATOR_ENABLED=true
# CHAT_ORCHESTRATOR_MAX_STEPS=8
# CHAT_ORCHESTRATOR_PLANNER_MAX_TOKENS=4096
# Characters of prior-step output a worker may be given, split across the
# step's dependencies. At 2,000 each a 19-finding CVE list reached the
# dependent step truncated, and the result was failed for the incomplete
# coverage that caused.
# CHAT_ORCHESTRATOR_DEPENDENCY_CONTEXT_MAX_CHARS=16000
# How far past its fair share of the run budget one step may go. The share is
# a convergence signal; at 1.0 it was also the execution cut, and was what
# ended every long investigation measured here. Loop detection now catches
# useless work instead (AGT-017).
# CHAT_ORCHESTRATOR_STEP_SHARE_HARD_MULTIPLE=3.0
# Consecutive tool calls with nothing new in them before a step is stopped.
# CHAT_ORCHESTRATOR_STUCK_CALL_WINDOW=8
# Consecutive already-answered calls before a delegation is told to report.
# SANDBOX_STUCK_REPEAT_LIMIT=3
# Maximum steps one step may expand into when it maps over items discovered by
# an earlier step. A larger collection is cut to this many and the run reports
# the coverage it did not have; 0 disables expansion.
# CHAT_ORCHESTRATOR_MAX_EXPANSION=8
# CHAT_ORCHESTRATOR_MAX_ITERATIONS=3
# CHAT_ORCHESTRATOR_MAX_PARALLEL=8
# Planner output ceiling; 0 derives it from the model. It was 4096, which is
# below what a reasoning model needs to think *and* emit a plan, so the planner
# returned nothing and fell back to a one-step plan on every turn.
# CHAT_ORCHESTRATOR_PLANNER_MAX_TOKENS=0
# Run each independent plan step of a batch as its own Temporal activity, so
# steps are placed across the worker fleet and fail independently. Interactive
# turns only; headless runs are already an activity of their own.
# CHAT_ORCHESTRATOR_DISTRIBUTED_ENABLED=true
# Batches smaller than this stay in the turn's own process.
# CHAT_ORCHESTRATOR_DISTRIBUTED_MIN_STEPS=2
# How long one distributed step may run. Keep it well under
# CHAT_TURN_TIMEOUT_SECONDS so the turn can still verify and answer.
# CHAT_ORCHESTRATOR_DISTRIBUTED_STEP_TIMEOUT_SECONDS=600
# Serialized step results larger than this are stored and passed by reference
# instead of travelling through Temporal history.
# CHAT_ORCHESTRATOR_DISTRIBUTED_INLINE_MAX_BYTES=262144
# Compatibility per-worker loop guard when all shared budget dimensions are
# disabled. Normal interactive and automated plans use the run-level budget.
# CHAT_ORCHESTRATOR_WORKER_MAX_ACTIONS=24
# Corrective retries when a worker ends a turn without calling the sentinel tool
# that submits its step result, before falling back to reading its plain text.
# CHAT_ORCHESTRATOR_WORKER_FINALIZE_RETRIES=2
# Characters of raw step evidence carried into the synthesizer's context, shared
# across a plan's steps, so a thin worker summary cannot lose a step's findings.
# Set 0 to send step summaries only.
# CHAT_ORCHESTRATOR_SYNTHESIS_EVIDENCE_MAX_CHARS=12000
# Multiple of the planner's per-step token estimate at which a step is stopped
# and asked to summarize, so one step cannot starve the rest of the plan.
# Floor on a step's token ceiling, as a multiple of the planner's per-step
# estimate. The ceiling is normally a share of what the run has left.
# CHAT_ORCHESTRATOR_STEP_BUDGET_OVERRUN=12.0
# How far past its fair share a step may go before being stopped rather than
# just asked to converge. 1.0 makes the share a hard cut.
# CHAT_ORCHESTRATOR_STEP_SHARE_HARD_MULTIPLE=1.0
# Episodic recall between sandbox sub-agents in one step, so delegation N+1 does
# not re-derive what N already found. 0 disables recall.
# CHAT_EPISODIC_RECALL_MAX_CHARS=4000
# CHAT_EPISODIC_MAX_ENTRIES=20
# The same carry between turns: what earlier turns established, and the files
# they left in the (persistent) sandbox, so a follow-up turn reads data instead
# of re-fetching it. The digest budget is the top-level agent's copy; 0 disables
# that without disabling the carry.
# CHAT_SESSION_MEMORY_MAX_ENTRIES=30
# CHAT_SESSION_MEMORY_MAX_RECEIPTS=40
# CHAT_SESSION_MEMORY_DIGEST_MAX_CHARS=2000
# Characters of earlier conversation given to the planner, so a follow-up that
# refers back ("cross-check that") resolves into self-contained step goals.
# CHAT_ORCHESTRATOR_PLANNER_CONTEXT_MAX_CHARS=6000
# The same for each sub-agent worker; kept tighter because it is charged per
# step per call. Set 0 to restore strict worker isolation.
# CHAT_ORCHESTRATOR_WORKER_CONTEXT_MAX_CHARS=2000
# Per-turn budget shared by interactive and automated chat. A run is budgeted in
# cost: CHAT_RUN_COST_BUDGET_USD is the limit to tune, and it bounds both the run
# and each plan step's share of it. CHAT_RUN_TOKEN_BUDGET is derived at 0 -- no
# token ceiling when the model is priced, since cost already bounds the run, and
# CHAT_RUN_UNPRICED_TOKEN_BUDGET when it is not. Set it positive to bound runs
# by tokens instead. A zero limit disables
# that dimension; CHAT_RUN_MAX_LLM_CALLS remains an emergency loop guard either
# way. Both cover sandbox sub-agent spend, 70-85% of a delegating turn.
# CHAT_RUN_TOKEN_BUDGET=0
# CHAT_RUN_UNPRICED_TOKEN_BUDGET=2000000
# CHAT_RUN_COST_BUDGET_USD=2.0
# CHAT_RUN_RESERVE_PERCENT=20
# CHAT_RUN_SOFT_LIMIT_PERCENT=75
# Emergency loop guard on LLM calls per run. 0 derives it from the plan, so it
# grows when a step expands; a positive value pins it. Set both this and the
# per-step figure to 0 to disable the dimension.
# CHAT_RUN_MAX_LLM_CALLS=0
# CHAT_RUN_LLM_CALLS_PER_STEP=96
# CHAT_RUN_UNPRICED_LLM_CALLS_PER_STEP=24
# Output tokens assumed for a call whose kind has not been seen yet; later calls
# are sized from what that kind was observed to emit, times the safety multiple.
# CHAT_BUDGET_OUTPUT_ESTIMATE_TOKENS=4096
# CHAT_BUDGET_OUTPUT_ESTIMATE_SAFETY=1.5
# How long a call waits when the run has budget left but it is reserved by calls
# still in flight. Committed spend over a limit still stops the run at once.
# 0 fails fast instead of waiting.
# CHAT_BUDGET_CONTENTION_WAIT_SECONDS=30
# Tracing. Off unless an OTLP endpoint is set. Spans cover the turn, its
# dispatch batches, each plan step and every model call, across the web service
# and the workers its steps run on. Any OTLP/HTTP collector works; LangSmith is
# one such endpoint. Content (prompts, results, tool output) is excluded unless
# TELEMETRY_RECORD_CONTENT is set -- it would carry graph data off the
# deployment.
# TELEMETRY_ENABLED=true
# TELEMETRY_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# TELEMETRY_OTLP_HEADERS=x-api-key=...
# TELEMETRY_SERVICE_NAME=seizu
# TELEMETRY_RECORD_CONTENT=false
# Optional role-specific models; empty values inherit CHAT_LLM_MODEL.
# The router only classifies a turn; empty inherits CHAT_LLM_PLANNER_MODEL.
# CHAT_LLM_ROUTER_MODEL=
# CHAT_LLM_PLANNER_MODEL=
# CHAT_LLM_WORKER_MODEL=
# CHAT_LLM_WORKER_SUMMARY_MODEL=
# CHAT_LLM_VERIFIER_MODEL=
# CHAT_LLM_SYNTHESIZER_MODEL=
# CHAT_LLM_ECONOMY_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=

# PostgreSQL LangGraph chat checkpoint storage.
# URL and credentials default to the corresponding SQL_DATABASE_* settings.
# Set the checkpoint-specific values only when it uses a different database or
# credentials. Credential-bearing URLs remain supported.
# Local Compose defaults to a separately provisioned `seizu-chat-checkpoints`
# database on the same PostgreSQL server.
# CHAT_CHECKPOINT_DATABASE_URL=postgresql://postgres:5432/seizu-chat-checkpoints
# CHAT_CHECKPOINT_DATABASE_USER=
# CHAT_CHECKPOINT_DATABASE_PASSWORD=
# CHAT_CHECKPOINT_DATABASE_POOL_MIN_SIZE=1
# CHAT_CHECKPOINT_DATABASE_POOL_MAX_SIZE=10
# CHAT_CHECKPOINT_CREATE_TABLE=false
# CHAT_MAX_PERSISTED_MESSAGES=200
# CHAT_HISTORY_LIMIT=100
# Chat turns run as Temporal workflows rather than inside the request,
# streaming through a short-lived event log so a dropped connection can
# reattach and replay. This means chat needs a reachable Temporal server.
# Retention is the reconnect window, not conversation history.
# CHAT_TURN_RETENTION_SECONDS=600
# Target latency between a token being produced and reaching the browser. The
# flush cadence and adaptive polling bounds are derived from this one value.
# CHAT_TURN_STREAM_LATENCY_MS=200
# How long one turn may run before its workflow gives up. The thread lease,
# reader deadline, cancellation allowance, and stop wait are derived from it.
# CHAT_TURN_TIMEOUT_SECONDS=900
# CHAT_TOOL_RESULT_MAX_ROWS=100
# CHAT_TOOL_RESULT_MAX_BYTES=200000

# RBAC settings.
# JWT claim that contains the user's Seizu role name.
# Configure your OIDC provider to embed the role directly as a claim (e.g. "seizu-admin").
# RBAC_ROLE_CLAIM=seizu_role
#
# Default role when the user's JWT has no RBAC_ROLE_CLAIM.
# Valid values: "seizu-viewer", "seizu-editor", "seizu-admin", or any user-defined role name.
# Set to "" to deny access to users without an explicit role claim.
# RBAC_DEFAULT_ROLE=seizu-viewer

# Shared secret used to sign report-query capability tokens.
# Generate a cryptographically random value with at least 32 bytes of entropy;
# 64 bytes is preferred. Encode as hex or base64 and keep it stable across
# restarts. If you use hex, 32 bytes = 64 characters and 64 bytes = 128
# characters. If you use base64, 32 bytes is typically 44 characters with
# padding. Rotate if exposed; rotation invalidates outstanding report tokens.
# REPORT_QUERY_SIGNING_SECRET=

# AES-256-GCM key used to encrypt the IDP refresh token in the browser
# session cookie. Must decode to exactly 32 bytes. Generate with:
#   python -c 'import base64,os;print(base64.b64encode(os.urandom(32)).decode())'
# Rotate if exposed; rotation forces all logged-in users to sign in again.
# SESSION_TOKEN_ENCRYPTION_KEY=

# Rolling lifetime of the session cookie (seconds). Default 18h. Each
# successful refresh re-issues the cookie with this Max-Age, capped at
# the IDP refresh token's absolute expiry recorded at login.
# SESSION_COOKIE_MAX_AGE_SECONDS=64800

# Override the session cookie name.
# SESSION_COOKIE_NAME=seizu_session

# Optional confidential-client settings for the BFF OAuth client. Public PKCE
# clients should keep the defaults. For confidential clients, set a secret and
# choose the IDP-supported auth method, usually client_secret_basic.
# OIDC_CLIENT_SECRET=
# OIDC_TOKEN_ENDPOINT_AUTH_METHOD=none
# OIDC_REVOCATION_ENDPOINT_AUTH_METHOD=none

# Whether to revoke the OIDC refresh token on logout.
# Failures are logged but never block the user's local logout.
# OIDC_REVOKE_REFRESH_TOKEN_ON_LOGOUT=true

# Absolute session upper bound (seconds) used only when the IDP's token
# response omits refresh_expires_in. Default: 30 days (Authentik's default).
# When the IDP advertises refresh_expires_in on a rotating refresh, the
# session's absolute cap is rolled forward to match.
# OIDC_REFRESH_TOKEN_FALLBACK_TTL_SECONDS=2592000

# Extra query parameters appended to the OIDC authorize request, as a
# comma-separated list of key=value pairs. Use for provider-specific knobs the
# standard scope can't express. Google, for instance, only issues a refresh
# token when the authorize request carries access_type=offline (and
# prompt=consent to re-issue one on repeat logins) instead of offline_access:
# OIDC_AUTHORIZE_EXTRA_PARAMS=access_type=offline,prompt=consent

# Enable RFC 7662 token introspection as a fallback when a Bearer token isn't a
# verifiable JWT. Required for IDPs that issue opaque (non-JWT) access tokens
# (e.g. Google, some Okta/Auth0 setups). Introspection authenticates with the
# client credentials, so it generally pairs with a confidential client.
# OIDC_ENABLE_TOKEN_INTROSPECTION=false
# Authlib client-auth method for the introspection endpoint. Defaults to
# OIDC_TOKEN_ENDPOINT_AUTH_METHOD.
# OIDC_INTROSPECTION_ENDPOINT_AUTH_METHOD=none

# How long (seconds) to cache the OIDC discovery document before re-fetching.
# A non-infinite TTL lets rotated endpoints/JWKS recover without a restart.
# OIDC_DISCOVERY_CACHE_TTL_SECONDS=3600

# Validate the ID token from the BFF code exchange (signature via the discovery
# JWKS, audience, issuer, and the login nonce). Secure by default; disable only
# for non-conformant providers whose ID token can't be verified server-side.
# OIDC_VALIDATE_ID_TOKEN=true

# MCP server at /api/v1/mcp. Disable to turn off the endpoint entirely.
# MCP_ENABLED=true

# Which built-in MCP tool groups to expose. User-defined toolsets are always available.
# Unset or empty: all groups enabled (default).
# "none": disable all built-in groups.
# Comma-separated list: only those groups (e.g. "graph,reports").
# Known groups: graph, reports, sandbox, scheduled_queries, skillsets, spaces, toolsets, roles.
# Note: sandbox is chat-only — it never appears on the MCP server endpoint regardless.
# MCP_ENABLED_BUILTINS=graph,plugins,reports,sandbox,scheduled_queries,skillsets,spaces,toolsets,roles

# Identifies this installation in the metadata of every sandbox it creates, and
# is the only ownership claim the reaper acts on. Set it (identically on the web
# service and the Temporal worker) whenever the sandbox credentials are shared
# with another Seizu installation -- e.g. production and staging on one E2B
# account. Installations that leave it unset share one bucket.
# SEIZU_DEPLOYMENT_ID=

# Sandbox delegation (sandbox__delegate chat tool — chat-only, not on MCP endpoint).
# Enable to let the chat agent delegate code execution / file operations to an
# isolated E2B (https://e2b.dev) or OpenKruise Agents sandbox.
# SANDBOX_ENABLED=false
# SANDBOX_API_KEY=              # E2B API key; leave empty for self-hosted auth
# SANDBOX_DOMAIN=               # Sandbox hostname (empty → E2B cloud). For OpenKruise
#                               # Agents: set to your cluster ingress hostname.
# SANDBOX_ALLOW_INTERNET=false  # Allow sandboxes to make outbound internet connections.
#                               # Defaults to false (network-isolated). Enable only when
#                               # the task explicitly requires external network access.
# Bounds ONE delegation. Sized for a short computation; a sub-agent doing real
# multi-step work (reading several files, sweeping search hits) exceeds it, and
# a timed-out delegation is retried from cold — which costs far more than the
# work would have. Raise it where delegations are substantial.
# SANDBOX_TIMEOUT_SECONDS=120
# SANDBOX_MAX_OUTPUT_BYTES=50000
# How long one Agent Plugin script may run inside the sandbox (seconds).
# SANDBOX_SCRIPT_TIMEOUT_SECONDS=60
# Whether the chat agent may use the conversation's sandbox directly rather than
# only through sandbox__delegate. Four more always-disclosed tools cost schema
# tokens on every call; they grant nothing delegation does not already grant.
# SANDBOX_DIRECT_TOOLS_ENABLED=true
# How much one delegation may return to the sub-agent inline before the rest
# is written to files. Cumulative and in tokens: the per-call bounds cannot
# catch many medium results (90 GitHub calls of a few KB each spent 1.1M
# tokens and wrote one receipt). 0 keeps only the per-call triggers.
# SANDBOX_INLINE_RESULT_BUDGET_TOKENS=60000
# Tools bound to every sandbox delegation regardless of progressive disclosure.
# Intersected with the caller's RBAC-permitted tools, so this never widens access.
# Set empty to route even graph access through a skill, at the cost of a
# discovery round trip on most delegations.
# SANDBOX_CORE_TOOLS=graph__query,graph__schema,graph__validate_query,graph__explain
# Caps for a sub-agent tool result written to a sandbox file instead of returned.
# Much larger than the in-context caps because a file never enters the model's
# context; still finite, since the result materializes in the Seizu process
# before it reaches the sandbox.
# Bytes of a file preview_file returns whole; larger files return shape plus the
# beginning, so a result file cannot be read back into context. 0 uses read_file.
# Bounds for a normal (non-chat) MCP tool call. Separate from the chat caps,
# which protect a model's context and are far tighter. A result that hits these
# comes back truncated with a marker rather than failing.
# MCP_TOOL_RESULT_MAX_ROWS=50000
# MCP_TOOL_RESULT_MAX_BYTES=25000000
# SANDBOX_PREVIEW_MAX_BYTES=2000
# Lifetime of the sandbox shared by a turn's delegations.
# SANDBOX_SESSION_TIMEOUT_SECONDS=1800
# Suspend that sandbox between turns and resume it on the next turn of the same
# thread, so a follow-up turn reads the data earlier turns fetched instead of
# re-fetching it. The full VM state is kept, memory included, so processes
# from one turn survive into the next of that thread (filesystem-only
# suspension leaves the code interpreter dead -- see SBX-005). Set false to
# destroy the sandbox at the end of every turn.
# SANDBOX_SESSION_PERSIST=true
# Retire chat sessions nobody has come back to, destroying the suspended sandbox
# each one holds along with it. THIS DELETES CHAT HISTORY, so it is OFF by
# default: retention is a policy you choose, not something an upgrade decides.
# Turning it on retires anything already past the threshold on the first sweep,
# so set CHAT_SESSION_REAP_IDLE_SECONDS before you enable it. The session is the
# unit because a sandbox belongs to its thread for as long as the thread exists
# -- see SBX-011. Runs as a Temporal Schedule, so a deployment with no Temporal
# worker does not reap. A session in use is never retired: the sweep claims it
# first and a turn starting in the same moment either wins or is refused.
# CHAT_SESSION_REAP_ENABLED=false
# CHAT_SESSION_REAP_IDLE_SECONDS=2592000
# CHAT_SESSION_REAP_INTERVAL_SECONDS=3600
# Also collect suspended sandboxes tagged for another deployment or not tagged
# at all -- only when these credentials belong to this deployment alone (this is
# also how sandboxes created before tagging existed get cleaned up).
# SANDBOX_REAP_UNTAGGED=false
# SANDBOX_FILE_RESULT_MAX_ROWS=50000
# SANDBOX_FILE_RESULT_MAX_BYTES=10000000
# SANDBOX_LLM_MODEL=            # Empty → inherits CHAT_LLM_WORKER_MODEL, then CHAT_LLM_MODEL

# OAuth 2.0 metadata for MCP clients (enables in-client auth, e.g. Claude Desktop).
# Set to your OIDC provider's authorization and token endpoints.
# Authentik example:
# MCP_OAUTH_AUTHORIZATION_ENDPOINT=https://authentik.example.com/application/o/seizu/authorize/
# MCP_OAUTH_TOKEN_ENDPOINT=https://authentik.example.com/application/o/token/
# MCP_OAUTH_ISSUER=https://authentik.example.com/application/o/seizu/
# (MCP_OAUTH_ISSUER defaults to JWT_ISSUER if unset)
# Public base URL of the MCP endpoint — required for RFC 9728 protected resource
# discovery and the WWW-Authenticate resource_metadata header.
# MCP_RESOURCE_URL=https://seizu.example.com/api/v1/mcp
# Maximum lifetime for mutating MCP/chat action approvals and denials.
# ACTION_CONFIRMATION_TTL_SECONDS=1800
# Optional public browser origin for confirmation URLs. Defaults to the origin
# derived from MCP_RESOURCE_URL when unset.
# SEIZU_PUBLIC_URL=https://seizu.example.com
# Internal authority URL used by the server for OIDC discovery. Defaults to
# OIDC_AUTHORITY; set this when the server cannot reach the public OIDC_AUTHORITY
# (e.g. environments with split internal/external hostnames).
#
# Both hostnames MUST present the same "issuer". Seizu identifies users by
# (iss, sub), so an IDP that derives its issuer from the request host (Authentik
# does) gives the same person two user records -- one for the browser BFF, one
# for MCP/CLI clients -- and private reports, query history, chat threads,
# scheduled chats and action confirmations diverge between them. Seizu compares
# the two discovery documents at startup and logs a mismatch loudly; fix it at
# the IDP, then pin JWT_ISSUER. See docs/root/install/security.md.
# OIDC_INTERNAL_AUTHORITY=https://internal-idp.example.com/application/o/seizu/
# Turn that startup issuer comparison into a hard startup failure.
# OIDC_REQUIRE_CONSISTENT_ISSUER=false
# Dev compose only: where the backend container's loopback :9000 is forwarded,
# so it reaches the dev Authentik under the same host the browser and MCP/CLI
# clients use (one Host means one issuer means one user -- see AUTH-002).
# Started only when DEVELOPMENT_ONLY_REQUIRE_AUTH is on.
# DEV_OIDC_LOOPBACK_TARGET=authentik-server:9000
#
# To point the dev stack at an IDP other than the compose Authentik, empty that
# variable *and* override the values below -- docker-compose.yml defaults them
# all to localhost:9000, which only exists because the forwarder creates it.
# Emptying it alone leaves authentication aimed at a listener that is no longer
# running. All of these are compose substitutions, so .env is enough; no
# compose override file is needed.
# DEV_OIDC_LOOPBACK_TARGET=
# OIDC_AUTHORITY=https://idp.example.com/application/o/seizu/
# JWKS_URL=https://idp.example.com/application/o/seizu/jwks/
# OIDC_CLIENT_ID=seizu
# JWT_AUDIENCE=seizu
# JWT_ISSUER=https://idp.example.com/application/o/seizu/
# OIDC_SCOPE=openid email offline_access
#
# For a confidential client, the secret is not enough on its own: the default
# token-endpoint auth method is "none", so authlib would send no credentials.
# Set both. The revocation and introspection methods default to whatever the
# token endpoint uses, so override them only if the IDP differs.
# OIDC_CLIENT_SECRET=
# OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
# OIDC_REVOCATION_ENDPOINT_AUTH_METHOD=
# OIDC_INTROSPECTION_ENDPOINT_AUTH_METHOD=
#
# Provider-specific extras, all optional: introspection for IDPs issuing opaque
# access tokens, authorize params for knobs the scope cannot express (Google),
# and the ID-token validation escape hatch for non-conformant providers.
# OIDC_ENABLE_TOKEN_INTROSPECTION=true
# OIDC_AUTHORIZE_EXTRA_PARAMS=access_type=offline,prompt=consent
# OIDC_VALIDATE_ID_TOKEN=true
# JWT_USERNAME_CLAIM=preferred_username
# ALLOWED_JWT_ALGORITHMS=RS256,ES256,ES512
# Override the dynamic client registration (RFC 7591) endpoint in OAuth metadata.
# When unset, Seizu serves its own built-in endpoint that returns OIDC_CLIENT_ID,
# which satisfies MCP clients (e.g. Claude Desktop) that require DCR support.
# MCP_OAUTH_REGISTRATION_ENDPOINT=
