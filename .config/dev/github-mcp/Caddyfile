{
	admin off
	auto_https off
}

:8080 {
	# The local gateway authenticates the user and forwards its own identity
	# headers, while the GitHub MCP server requires a GitHub API token in
	# Authorization. Keep those credentials separate: this adapter is reachable
	# only on the Compose network, behind the gateway's github route.
	rewrite * /
	reverse_proxy external-mcp-github:8082 {
		header_up Authorization "Bearer {env.GITHUB_PERSONAL_ACCESS_TOKEN}"
		header_up -X-Pomerium-Jwt-Assertion
	}
}
